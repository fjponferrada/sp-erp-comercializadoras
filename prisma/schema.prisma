}

model ForecastModelCache {
  id        String   @id @default(cuid())
  modelData Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScrapingJob {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  logs      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SyncJob {
  id        String   @id @default(cuid())
  type      String   @default("FTP_SYNC")
  status    String   @default("PENDING")
  progress  Int      @default(0)
  total     Int      @default(0)
  logs      String?
  results   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
}

model Ppa {
  id               String       @id @default(cuid())
  name             String
  companyId        String
  type             PpaType
  subtype          PpaSubtype
  startDate        DateTime
  endDate          DateTime?
  priceType        PpaPriceType
  priceValue       Float?
  basePowerMw      Float?
  profileData      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  includeInPricing Boolean      @default(true)
  company          Company      @relation(fields: [companyId], references: [id])
}

model SystemComponentPrice {
  id        String   @id @default(cuid())
  component String
  date      DateTime @db.Date
  values    Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   String?

  @@unique([component, date])
  @@index([component])
  @@index([date])
}

model RegulatedCost {
  id          String   @id @default(cuid())
  concept     String
  tariff      String
  validFrom   DateTime @db.Date
  validTo     DateTime @db.Date
