  updatedAt  DateTime @updatedAt
  jsonData   Json
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])

  @@unique([date, cierre, region, matricial, total, upr, resolution, companyId])
  @@index([date, cierre, region])
}

model PendingEnergySummary {
