model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model LoadCurve {
  id            String     @id @default(cuid())
  cups          String
  date          DateTime   @db.Date
  readings      Float[]
  resolution    Resolution
  isProvisional Boolean
  source        String
  type          CurveType  @default(CONSUMPTION)

  @@unique([cups, date, type])
  @@index([date])
}

model WeatherHistory {
  date         DateTime @db.Date
  temperatures Float[]
  id           String   @id @default(cuid())
  province     String

  @@unique([date, province])
  @@index([date])
}

model AggregatedLoadCurve {
  id               String   @id @default(cuid())
  date             DateTime @db.Date
  segment          String
  totalConsumption Float[]
  clientCount      Int
  temperature      Float[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  province         String
  tariff           String   @default("2.0TD")
