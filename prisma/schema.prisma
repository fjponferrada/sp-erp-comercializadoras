model RegulatedDailyCost {
  id        String    @id @default(cuid())
  concept   String
  amount    Float
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  label     String?

  @@index([concept])
}

enum Role {
